# Sin estas variables, la API guarda contacto/registro pero NO envía emails.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ACV2.Music
# Casilla REAL donde querés recibir alertas (contacto + nuevos usuarios).
